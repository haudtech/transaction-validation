{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TransactionValidation.Gateway",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/TransactionValidation.Gateway/bin/Debug/net10.0/TransactionValidation.Gateway.dll",
      "cwd": "${workspaceFolder}/src/TransactionValidation.Gateway",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5082"
      },
      "justMyCode": true,
      "console": "internalConsole"
    },
    {
      "name": "TransactionValidation.Gateway.Management",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/TransactionValidation.Gateway.Management/bin/Debug/net10.0/TransactionValidation.Gateway.Management.dll",
      "cwd": "${workspaceFolder}/src/TransactionValidation.Gateway.Management",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5083"
      },
      "justMyCode": true,
      "console": "internalConsole"
    },
    {
      "name": "TransactionValidation.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/TransactionValidation.Api/bin/Debug/net10.0/TransactionValidation.Api.dll",
      "cwd": "${workspaceFolder}/src/TransactionValidation.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080",
        "RabbitMq__HostName": "127.0.0.1",
        "RabbitMq__Port": "5672",
        "PartnerVerification__BaseUrl": "http://localhost:5081/"
      },
      "justMyCode": true,
      "console": "internalConsole"
    },
    {
      "name": "TransactionValidation.Mock",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/TransactionValidation.Mock/bin/Debug/net10.0/TransactionValidation.Mock.dll",
      "cwd": "${workspaceFolder}/src/TransactionValidation.Mock",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5081",
        "RabbitMqConsumer__HostName": "127.0.0.1",
        "RabbitMqConsumer__Port": "5672",
        "RabbitMqAuditConsumer__HostName": "127.0.0.1",
        "RabbitMqAuditConsumer__Port": "5672"
      },
      "justMyCode": true,
      "console": "internalConsole"
    },
    {
      "name": "Open API Swagger",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5080/swagger",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Open Mock Endpoint",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5081",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Flow (API + Mock)",
      "configurations": [
        "TransactionValidation.Api",
        "TransactionValidation.Mock"
      ],
      "stopAll": true
    },
    {
      "name": "Debug Full Flow + Browser",
      "configurations": [
        "TransactionValidation.Api",
        "TransactionValidation.Mock",
        "Open API Swagger",
        "Open Mock Endpoint"
      ],
      "stopAll": true
    }
  ]
}
