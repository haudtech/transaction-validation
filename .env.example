# Example environment variables (UPPER_SNAKE_CASE)
ASPNETCORE_ENVIRONMENT=Development
API_HOST_PORT=5000

# Partner verification client
# Use mock:8080 when API runs in Docker; use localhost:5002 when API runs on host.
PARTNERVERIFICATION__BASEURL=http://mock:8080/

# RabbitMQ
RABBITMQ__HOSTNAME=rabbitmq
RABBITMQ__PORT=5672
RABBITMQ__USERNAME=guest
RABBITMQ__PASSWORD=guest
RABBITMQ__QUEUENAME=partner-transactions
RABBITMQCONSUMER__DURABLE=true
RABBITMQCONSUMER__AUTOACK=false

# Security
SECURITY__APIKEY=replace-with-strong-api-key

# Optional Azure App Insights (leave empty for local dev)
APPLICATIONINSIGHTS__CONNECTIONSTRING=
