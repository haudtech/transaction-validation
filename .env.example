# Example environment variables (UPPER_SNAKE_CASE)
ASPNETCORE_ENVIRONMENT=Development
API_HOST_PORT=5000

# Partner verification client
# Use mock:8080 when API runs in Docker; use localhost:5002 when API runs on host.
PARTNERVERIFICATION__BASEURL=http://mock:8080/

# RabbitMQ
RABBITMQ__HOSTNAME=rabbitmq
RABBITMQ__PORT=5672
RABBITMQ__USERNAME=guest
RABBITMQ__PASSWORD=guest
RABBITMQ__QUEUENAME=partner-transactions
RABBITMQ__EXCHANGENAME=partner.transactions
RABBITMQ__EXCHANGETYPE=topic
RABBITMQ__ROUTINGKEYPREFIX=partner.transaction
RABBITMQ__ALTERNATEEXCHANGENAME=partner.transactions.unrouted
RABBITMQ__UNROUTEDQUEUENAME=partner-transactions.unrouted
RABBITMQ__PUBLISHCONFIRMTIMEOUTSECONDS=5
RABBITMQCONSUMER__DURABLE=true
RABBITMQCONSUMER__AUTOACK=false
RABBITMQCONSUMER__BINDINGPATTERN=partner.transaction.#
RABBITMQCONSUMER__ENABLED=true

# Second independent Mock consumer (audit subscription)
RABBITMQAUDITCONSUMER__HOSTNAME=rabbitmq
RABBITMQAUDITCONSUMER__PORT=5672
RABBITMQAUDITCONSUMER__USERNAME=guest
RABBITMQAUDITCONSUMER__PASSWORD=guest
RABBITMQAUDITCONSUMER__EXCHANGENAME=partner.transactions
RABBITMQAUDITCONSUMER__QUEUENAME=partner-transactions.audit
RABBITMQAUDITCONSUMER__BINDINGPATTERN=partner.transaction.accepted
RABBITMQAUDITCONSUMER__DURABLE=true
RABBITMQAUDITCONSUMER__AUTOACK=false
RABBITMQAUDITCONSUMER__ENABLED=true
RABBITMQAUDITCONSUMER__POLLINTERVALMILLISECONDS=500

# Security
SECURITY__APIKEY=replace-with-strong-api-key

# Broker selection (RabbitMq is the default local path; set AzureServiceBus for Azure validation)
MESSAGING__BROKERTYPE=AzureServiceBus

# Azure Service Bus (set a real connection string before running Azure mode)
SERVICEBUSPUBLISHER__CONNECTIONSTRING=Endpoint=sb://<your-namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<your-key>
SERVICEBUSPUBLISHER__TOPICNAME=partner.transactions
SERVICEBUSPUBLISHER__SUBJECT=partner.transaction.accepted
SERVICEBUSPUBLISHER__ROUTINGKEY=partner.transaction.accepted
SERVICEBUSPUBLISHER__EVENTTYPE=partner.transaction.accepted

SERVICEBUSCONSUMER__ENABLED=true
SERVICEBUSCONSUMER__CONNECTIONSTRING=Endpoint=sb://<your-namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<your-key>
SERVICEBUSCONSUMER__TOPICNAME=partner.transactions
SERVICEBUSCONSUMER__SUBSCRIPTIONNAME=partner-transactions
SERVICEBUSCONSUMER__FILTER=
SERVICEBUSCONSUMER__AUTOCOMPLETE=false
SERVICEBUSCONSUMER__MAXCONCURRENTCALLS=1

SERVICEBUSAUDITCONSUMER__ENABLED=true
SERVICEBUSAUDITCONSUMER__CONNECTIONSTRING=Endpoint=sb://<your-namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<your-key>
SERVICEBUSAUDITCONSUMER__TOPICNAME=partner.transactions
SERVICEBUSAUDITCONSUMER__SUBSCRIPTIONNAME=partner-transactions.audit
SERVICEBUSAUDITCONSUMER__FILTER=
SERVICEBUSAUDITCONSUMER__AUTOCOMPLETE=false
SERVICEBUSAUDITCONSUMER__MAXCONCURRENTCALLS=1

# Optional Azure App Insights (leave empty for local dev)
APPLICATIONINSIGHTS__CONNECTIONSTRING=
