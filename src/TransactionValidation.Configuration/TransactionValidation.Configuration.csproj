    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />

    <!-- Messaging integration -->
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransactionValidation.Core\TransactionValidation.Core.csproj" />
    <ProjectReference Include="..\TransactionValidation.Integration\TransactionValidation.Integration.csproj" />
    <ProjectReference Include="..\TransactionValidation.Messaging\TransactionValidation.Messaging.csproj" />
