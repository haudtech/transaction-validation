{
  "Gateway": {
    "SecretsDirectory": ".secrets",
    "BackendCredentialSecretName": "transaction-validation-backend",
    "PolicyStore": {
      "ConnectionTimeoutSeconds": 5,
      "CommandTimeoutSeconds": 5
    }
  },
  "ReverseProxy": {
    "Routes": {
      "transactionValidationV1": {
        "ClusterId": "transactionValidation",
        "Match": {
          "Path": "/transactions/v1/partner/transactions",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          {
            "PathSet": "/api/v1/partner/transactions"
          }
        ]
      }
    },
    "Clusters": {
      "transactionValidation": {
        "Destinations": {
          "api": {
            "Address": "http://api:8080/"
          }
        }
      }
    }
  }
}
